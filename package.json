{
  "name": "agentbus-mcp",
  "version": "0.4.1",
  "description": "Pointer-based handoff bus for multi-agent workflows: pass references + SHA-256 instead of copying payloads. MCP stdio server + CLI, zero dependencies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agentbus": "./bin/bus.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "test/accept.mjs",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node ./scripts/postinstall-adapt.mjs",
    "test": "node test/accept.mjs",
    "test:compat": "node test/accept.mjs",
    "setup": "node bin/bus.js setup",
    "doctor": "node bin/bus.js doctor"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "multi-agent",
    "agent-orchestration",
    "agent-handoff",
    "codex",
    "claude-code",
    "gemini-cli",
    "opencode",
    "cursor",
    "sqlite",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dfggg121/agentbus.git"
  },
  "bugs": {
    "url": "https://github.com/dfggg121/agentbus/issues"
  },
  "homepage": "https://github.com/dfggg121/agentbus#readme"
}
